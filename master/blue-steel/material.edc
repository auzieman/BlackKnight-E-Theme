// Original raster material demonstrator. Not an Enlightenment border override.
images { image: "plate.png" COMP; image: "button.png" COMP; image: "glint.png" COMP; }
collections {
group { name: "bk/material/titlebar"; min: 480 72;
 parts { 
part { name: "clip"; type: RECT; mouse_events: 0;
 description { state: "default" 0.0; color: 255 255 255 255; }
}
part { name: "plate"; type: IMAGE; mouse_events: 0; clip_to: "clip";
 description { state: "default" 0.0;
  rel2.offset: -1 21;
  image { normal: "plate.png"; border: 280 280 48 240; border_scale: 1; border_scale_by: 0.1; }
  color: 160 178 199 255;
 }
 description { state: "active" 0.0; inherit: "default" 0.0; color: 255 255 255 255; }
}
part { name: "title"; type: TEXT; mouse_events: 0;
 description { state: "default" 0.0;
  rel1.offset: 40 10; rel2.offset: -174 -10;
  color: 175 193 211 255;
  text { text: "BlackKnight"; font: "Sans"; size: 16; align: 0.0 0.5; ellipsis: 1.0; }
 }
 description { state: "active" 0.0; inherit: "default" 0.0; color: 233 245 255 255; }
}
part { name: "glint"; type: IMAGE; mouse_events: 0; clip_to: "clip";
 description { state: "default" 0.0;
  image.normal: "glint.png";
  rel1.relative: 0.0 0.0; rel1.offset: -80 -10;
  rel2.relative: 0.0 0.0; rel2.offset: 80 22;
  color: 255 255 255 0;
 }
 description { state: "start" 0.0; inherit: "default" 0.0; color: 255 255 255 220; }
 description { state: "end" 0.0; inherit: "start" 0.0;
  rel1.relative: 1.0 0.0; rel2.relative: 1.0 0.0;
 }
 description { state: "gone" 0.0; inherit: "end" 0.0; color: 255 255 255 0; }
}
part { name: "button.minimize"; type: IMAGE; mouse_events: 0;
 description { state: "default" 0.0; rel1.relative: 1.0 0.5; rel2.relative: 1.0 0.5; rel1.offset: -156 -19; rel2.offset: -119 18;
 image { normal: "button.png"; border: 160 160 160 160; border_scale: 1; border_scale_by: 0.035; }
 color: 180 200 220 255;
 }
 description { state: "hover" 0.0; inherit: "default" 0.0; color: 255 255 255 255; }
 description { state: "pressed" 0.0; inherit: "default" 0.0; color: 100 150 195 255; }
 description { state: "disabled" 0.0; inherit: "default" 0.0; color: 110 120 130 170; }
}
part { name: "label.minimize"; type: TEXT; mouse_events: 0;
 description { state: "default" 0.0;
 rel1.to: "button.minimize"; rel2.to: "button.minimize";
 color: 225 240 255 255; text { text: "−"; font: "Sans"; size: 18; }
 }
}
part { name: "event.minimize"; type: RECT;
 description { state: "default" 0.0;
 rel1.to: "button.minimize"; rel2.to: "button.minimize"; color: 0 0 0 0;
 }
 description { state: "disabled" 0.0; inherit: "default" 0.0; visible: 0; }
}
part { name: "button.maximize"; type: IMAGE; mouse_events: 0;
 description { state: "default" 0.0; rel1.relative: 1.0 0.5; rel2.relative: 1.0 0.5; rel1.offset: -112 -19; rel2.offset: -75 18;
 image { normal: "button.png"; border: 160 160 160 160; border_scale: 1; border_scale_by: 0.035; }
 color: 180 200 220 255;
 }
 description { state: "hover" 0.0; inherit: "default" 0.0; color: 255 255 255 255; }
 description { state: "pressed" 0.0; inherit: "default" 0.0; color: 100 150 195 255; }
 description { state: "disabled" 0.0; inherit: "default" 0.0; color: 110 120 130 170; }
}
part { name: "label.maximize"; type: TEXT; mouse_events: 0;
 description { state: "default" 0.0;
 rel1.to: "button.maximize"; rel2.to: "button.maximize";
 color: 225 240 255 255; text { text: "□"; font: "Sans"; size: 18; }
 }
}
part { name: "event.maximize"; type: RECT;
 description { state: "default" 0.0;
 rel1.to: "button.maximize"; rel2.to: "button.maximize"; color: 0 0 0 0;
 }
 description { state: "disabled" 0.0; inherit: "default" 0.0; visible: 0; }
}
part { name: "button.close"; type: IMAGE; mouse_events: 0;
 description { state: "default" 0.0; rel1.relative: 1.0 0.5; rel2.relative: 1.0 0.5; rel1.offset: -68 -19; rel2.offset: -31 18;
 image { normal: "button.png"; border: 160 160 160 160; border_scale: 1; border_scale_by: 0.035; }
 color: 180 200 220 255;
 }
 description { state: "hover" 0.0; inherit: "default" 0.0; color: 255 255 255 255; }
 description { state: "pressed" 0.0; inherit: "default" 0.0; color: 100 150 195 255; }
 description { state: "disabled" 0.0; inherit: "default" 0.0; color: 110 120 130 170; }
}
part { name: "label.close"; type: TEXT; mouse_events: 0;
 description { state: "default" 0.0;
 rel1.to: "button.close"; rel2.to: "button.close";
 color: 225 240 255 255; text { text: "×"; font: "Sans"; size: 18; }
 }
}
part { name: "event.close"; type: RECT;
 description { state: "default" 0.0;
 rel1.to: "button.close"; rel2.to: "button.close"; color: 0 0 0 0;
 }
 description { state: "disabled" 0.0; inherit: "default" 0.0; visible: 0; }
}
 }
 programs { 
program { name: "focus-stop"; signal: "bk,state,active"; source: "*";
 action: ACTION_STOP; target: "focus"; target: "unfocus";
 target: "glint-start"; target: "glint-sweep"; target: "glint-fade";
 after: "focus"; after: "glint-start";
}
program { name: "focus"; action: STATE_SET "active" 0.0;
 target: "plate"; target: "title"; transition: SINUSOIDAL 0.18;
}
program { name: "glint-start"; action: STATE_SET "start" 0.0;
 target: "glint"; after: "glint-sweep";
}
program { name: "glint-sweep"; action: STATE_SET "end" 0.0;
 target: "glint"; transition: LINEAR 0.75; after: "glint-fade";
}
program { name: "glint-fade"; action: STATE_SET "gone" 0.0;
 target: "glint"; transition: DECELERATE 0.15;
}
program { name: "unfocus-stop"; signal: "bk,state,inactive"; source: "*";
 action: ACTION_STOP; target: "focus"; target: "unfocus";
 target: "glint-start"; target: "glint-sweep"; target: "glint-fade";
 after: "unfocus"; after: "glint-reset";
}
program { name: "unfocus"; action: STATE_SET "default" 0.0;
 target: "plate"; target: "title"; transition: SINUSOIDAL 0.18;
}
program { name: "glint-reset"; action: STATE_SET "default" 0.0; target: "glint"; }
program { name: "hidden-stop"; signal: "bk,state,hidden"; source: "*";
 action: ACTION_STOP; target: "glint-start"; target: "glint-sweep"; target: "glint-fade";
 after: "glint-reset";
}
program { name: "minimize-mouse-in"; signal: "mouse,in"; source: "event.minimize";
 action: STATE_SET "hover" 0.0; target: "button.minimize";
}
program { name: "minimize-mouse-out"; signal: "mouse,out"; source: "event.minimize";
 action: STATE_SET "default" 0.0; target: "button.minimize";
}
program { name: "minimize-mouse-down-1"; signal: "mouse,down,1"; source: "event.minimize";
 action: STATE_SET "pressed" 0.0; target: "button.minimize";
}
program { name: "minimize-mouse-up-1"; signal: "mouse,up,1"; source: "event.minimize";
 action: STATE_SET "hover" 0.0; target: "button.minimize";
}
program { signal: "mouse,clicked,1"; source: "event.minimize";
 action: SIGNAL_EMIT "bk,action,minimize" "minimize";
}
program { signal: "bk,control,disabled"; source: "minimize";
 action: STATE_SET "disabled" 0.0; target: "button.minimize"; target: "event.minimize";
}
program { signal: "bk,control,enabled"; source: "minimize";
 action: STATE_SET "default" 0.0; target: "button.minimize"; target: "event.minimize";
}
program { name: "maximize-mouse-in"; signal: "mouse,in"; source: "event.maximize";
 action: STATE_SET "hover" 0.0; target: "button.maximize";
}
program { name: "maximize-mouse-out"; signal: "mouse,out"; source: "event.maximize";
 action: STATE_SET "default" 0.0; target: "button.maximize";
}
program { name: "maximize-mouse-down-1"; signal: "mouse,down,1"; source: "event.maximize";
 action: STATE_SET "pressed" 0.0; target: "button.maximize";
}
program { name: "maximize-mouse-up-1"; signal: "mouse,up,1"; source: "event.maximize";
 action: STATE_SET "hover" 0.0; target: "button.maximize";
}
program { signal: "mouse,clicked,1"; source: "event.maximize";
 action: SIGNAL_EMIT "bk,action,maximize" "maximize";
}
program { signal: "bk,control,disabled"; source: "maximize";
 action: STATE_SET "disabled" 0.0; target: "button.maximize"; target: "event.maximize";
}
program { signal: "bk,control,enabled"; source: "maximize";
 action: STATE_SET "default" 0.0; target: "button.maximize"; target: "event.maximize";
}
program { name: "close-mouse-in"; signal: "mouse,in"; source: "event.close";
 action: STATE_SET "hover" 0.0; target: "button.close";
}
program { name: "close-mouse-out"; signal: "mouse,out"; source: "event.close";
 action: STATE_SET "default" 0.0; target: "button.close";
}
program { name: "close-mouse-down-1"; signal: "mouse,down,1"; source: "event.close";
 action: STATE_SET "pressed" 0.0; target: "button.close";
}
program { name: "close-mouse-up-1"; signal: "mouse,up,1"; source: "event.close";
 action: STATE_SET "hover" 0.0; target: "button.close";
}
program { signal: "mouse,clicked,1"; source: "event.close";
 action: SIGNAL_EMIT "bk,action,close" "close";
}
program { signal: "bk,control,disabled"; source: "close";
 action: STATE_SET "disabled" 0.0; target: "button.close"; target: "event.close";
}
program { signal: "bk,control,enabled"; source: "close";
 action: STATE_SET "default" 0.0; target: "button.close"; target: "event.close";
}
 }
}
#include "control-group.edc"
}
